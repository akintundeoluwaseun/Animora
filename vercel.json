{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "PUPPETEER_SKIP_DOWNLOAD=true npm install",
  "buildCommand": "node scripts/vercel-build.js",
  "outputDirectory": "web/dist",
  "functions": {
    "api/index.js": {
      "maxDuration": 300,
      "includeFiles": "{server/**,assets/music/tracks.json,assets/music/library.json,assets/music/beats.json,assets/sfx/registry.json,node_modules/gsap/dist/**}"
    }
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api"
    },
    {
      "source": "/files/:path*",
      "destination": "/api"
    },
    {
      "source": "/download/:path*",
      "destination": "/api"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "regions": [
    "lhr1"
  ],
  "headers": [
    {
      "source": "/(premium|sfx|music|vendor|voices)/(.*)",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    }
  ]
}
