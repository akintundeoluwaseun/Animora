# ============================================================
# AdFlash configuration. Copy to .env and fill in what you have.
# Everything works without any keys (practice AI, local database,
# local files, sandbox payments) so you can demo offline.
# ============================================================

# --- Server ---
# off = no sign-in, no ads, no limits (testing). on = accounts, Free/Pro plans and ads.
AUTH=off
PORT=3000
# The public address of this server (used in links to videos and files).
PUBLIC_BASE_URL=http://localhost:3000
# Long random string. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=

# --- Google Gemini (the ONLY external AI service) ---
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# auto = Gemini when a key is set, otherwise the built-in practice AI. Or force: gemini | offline
AI_MODE=auto
# Optional model overrides (defaults: gemini-flash-latest for chat, gemini-pro-latest for code)
GEMINI_CHAT_MODEL=
GEMINI_CODE_MODEL=

# --- Supabase (database + file storage) ---
# Database: Project Settings > Database > Connection string (URI). Use the "Session pooler" string.
# Leave empty to use the built-in local database (data/pglite).
DATABASE_URL=
# Storage: Project Settings > API. Leave empty to store files on this server's disk (data/storage).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=adflash

# --- Payments: Access Bank Wallet-as-a-Service (Africa Fintech Foundry) ---
# sandbox = built-in test payments (no money moves). accessbank = real WaaS API.
PAYMENT_PROVIDER=sandbox
ACCESSBANK_BASE_URL=https://api-sandbox.accessbankplc.com
ACCESSBANK_AUTHORIZATION_KEY=
ACCESSBANK_SUBSCRIPTION_KEY=
ACCESSBANK_MERCHANT_ID=
# AdFlash's own wallet that sends creator payouts
ACCESSBANK_PAYOUT_WALLET=
ACCESSBANK_PAYOUT_WALLET_NAME=ADFLASH

# --- Render engine ---
# Run the render worker inside the web server (simplest). Set false if you run `npm run worker` separately.
RUN_WORKER=true
WORKER_CONCURRENCY=1
# Parallel capture pages per render (default: CPU cores, max 4)
ADFLASH_WORKERS=
# auto | beginframe | screenshot
ADFLASH_CAPTURE_MODE=auto
# Path to Chrome / chrome-headless-shell if not using Puppeteer's download
CHROME_PATH=

# --- Business rules (defaults shown) ---
PRO_PRICE_NGN=5000
PRO_VIDEOS_PER_MONTH=30
FREE_MAX_SECONDS=60
PRO_MAX_SECONDS=300
AD_SECONDS=15
AD_REVENUE_PER_VIEW_NGN=40
CREATOR_SHARE=0.3
MIN_PAYOUT_NGN=1000
# Seed demo history (royalties, a sample video) on first start
SEED_DEMO_HISTORY=true
